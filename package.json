{
  "name": "claude-code",
  "version": "1.0.0",
  "description": "Claude Code CLI - Anthropic's official CLI tool",
  "type": "module",
  "main": "src/main.tsx",
  "scripts": {
    "start": "bun run src/main.tsx",
    "dev": "bun run --watch src/main.tsx",
    "build": "bun build src/main.tsx --outdir dist --target bun",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@anthropic-ai/sdk-resources": "^0.26.0",
    "@commander-js/extra-typings": "^12.1.0",
    "axios": "^1.7.9",
    "chalk": "^5.3.0",
    "ink": "^4.4.1",
    "lodash-es": "^4.17.21",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.15",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.18",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  }
}